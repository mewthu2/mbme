{% doc %}
  Renders a country/currency and language selector that submits on change.

  @param {string} id - Unique id prefix for the form controls

  @example
  {% render 'localization-form', id: 'FooterLocalization' %}
{% enddoc %}

{%- form 'localization', id: id, class: 'localization-form' -%}
  {%- if localization.available_countries.size > 1 -%}
    <div class="localization-form__field">
      <label class="visually-hidden" for="{{ id }}-country">{{ 'localization.country' | t }}</label>
      <select id="{{ id }}-country" name="country_code" data-localization-select>
        {%- for country in localization.available_countries -%}
          <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
            {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
          </option>
        {%- endfor -%}
      </select>
      {% render 'icon', name: 'chevron-down' %}
    </div>
  {%- endif -%}
  {%- if localization.available_languages.size > 1 -%}
    <div class="localization-form__field">
      <label class="visually-hidden" for="{{ id }}-language">{{ 'localization.language' | t }}</label>
      <select id="{{ id }}-language" name="language_code" data-localization-select>
        {%- for language in localization.available_languages -%}
          <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
            {{ language.endonym_name | capitalize }}
          </option>
        {%- endfor -%}
      </select>
      {% render 'icon', name: 'chevron-down' %}
    </div>
  {%- endif -%}
  <noscript><button class="button">{{ 'localization.update' | t }}</button></noscript>
{%- endform -%}

{% stylesheet %}
  .localization-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .localization-form__field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .localization-form__field select {
    appearance: none;
    max-width: 14rem;
    padding: 0.4rem 1.75rem 0.4rem 0.5rem;
    border: 0;
    background: transparent;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .localization-form__field .icon {
    position: absolute;
    right: 0.25rem;
    width: 0.9rem;
    pointer-events: none;
  }

  .localization-form__field option {
    color: #111;
    text-transform: none;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('change', (event) => {
    if (event.target.matches('[data-localization-select]')) event.target.form.submit();
  });
{% endjavascript %}

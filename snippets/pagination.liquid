{% doc %}
  Renders accessible pagination links.

  @param {object} paginate - The paginate object

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

<nav aria-label="{{ 'general.pagination' | t }}">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
      <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</a></li>
    {%- endif -%}
  </ul>
</nav>

{% doc %}
  Renders the cart line items list used by the cart drawer and cart page.

  @param {string} context - Either 'drawer' or 'page'

  @example
  {% render 'cart-line-items', context: 'drawer' %}
{% enddoc %}

<ul class="cart-items cart-items--{{ context }}" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="cart-item__media media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}
              {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-item__actions">
          <quantity-input class="quantity">
            <button type="button" name="minus" aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
            <input
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
              step="{{ item.variant.quantity_rule.increment }}"
              aria-label="{{ 'cart.quantity_for' | t: product: item.product.title | escape }}"
              data-line="{{ forloop.index }}"
            >
            <button type="button" name="plus" aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
          </quantity-input>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-line-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</a>
        </div>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>

{% stylesheet %}
  .cart-items {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-items--page .cart-item {
    grid-template-columns: 8rem 1fr auto;
  }

  .cart-item__media {
    display: block;
    aspect-ratio: 1;
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cart-item__title {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cart-item__meta {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .cart-item__discount {
    font-size: 0.8125rem;
    color: var(--color-sale);
  }

  .cart-item__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .cart-item__remove {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-underline-offset: 0.3em;
  }

  .cart-item__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 0.875rem;
  }

  .cart-item__price s {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .quantity {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
  }

  .quantity button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .quantity .icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .quantity input {
    width: 2.5rem;
    border: 0;
    background: transparent;
    text-align: center;
    -moz-appearance: textfield;
  }

  .quantity input::-webkit-outer-spin-button,
  .quantity input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }
{% endstylesheet %}

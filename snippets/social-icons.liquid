{% doc %}
  Renders the social media links configured in theme settings, plus WhatsApp when configured.

  @param {string} [class] - Extra CSS class for the list
  @param {boolean} [include_whatsapp] - Also render the WhatsApp link from theme settings

  @example
  {% render 'social-icons', class: 'social-icons--circle', include_whatsapp: true %}
{% enddoc %}

{%- capture links -%}
  {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}<li><a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>{%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
  {%- if settings.social_youtube_link != blank -%}<li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
  {%- if settings.social_twitter_link != blank -%}<li><a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="X">{% render 'icon', name: 'twitter' %}</a></li>{%- endif -%}
  {%- if settings.social_linkedin_link != blank -%}<li><a href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="LinkedIn">{% render 'icon', name: 'linkedin' %}</a></li>{%- endif -%}
  {%- if include_whatsapp and settings.whatsapp_number != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener" class="social-icons__link" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a></li>{%- endif -%}
{%- endcapture -%}

{%- if links != blank -%}
  <ul class="social-icons {{ class }}" role="list">{{ links }}</ul>
{%- elsif request.design_mode -%}
  <p class="social-icons__empty">{{ 'general.social_placeholder' | t }}</p>
{%- endif -%}

{% stylesheet %}
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .social-icons__link {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .social-icons__link:hover {
    color: var(--color-accent);
  }

  .social-icons--circle {
    gap: 0.625rem;
  }

  .social-icons--circle .social-icons__link {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
  }

  .social-icons--circle .social-icons__link .icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .social-icons--circle .social-icons__link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
  }

  .social-icons__empty {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% doc %}
  Renders payment method icons: the store's enabled payment types (or a manual fallback list), plus optional Pix and Boleto badges.

  @param {string} [manual_list] - Comma-separated payment types used when the store reports none, or when forced
  @param {boolean} [force_manual] - Always use the manual list
  @param {boolean} [show_pix] - Render a Pix badge
  @param {boolean} [show_boleto] - Render a Boleto badge

  @example
  {% render 'payment-icons', manual_list: 'visa,master,elo', show_pix: true %}
{% enddoc %}

{%- liquid
  assign types = shop.enabled_payment_types
  if force_manual or types.size == 0
    assign types = manual_list | default: 'visa,master,american_express,elo,hipercard,diners_club' | remove: ' ' | split: ','
  endif
-%}

<ul class="payment-icons" role="list">
  {%- for type in types -%}
    {%- if type != blank -%}
      <li>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
    {%- endif -%}
  {%- endfor -%}
  {%- if show_pix -%}
    <li>
      <svg class="payment-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 38 24" width="38" height="24" role="img" aria-labelledby="pi-pix-theme"><title id="pi-pix-theme">Pix</title><rect x=".5" y=".5" width="37" height="23" rx="2.5" fill="#fff" stroke="#000" stroke-opacity=".07"/><path fill="#32BCAD" d="M11.3 7.2a1.5 1.5 0 0 1 2.1 0l2.2 2.2-1 1-1.7-1.7a.6.6 0 0 0-.9 0L10.3 10.4l-1-1 2-2.2Zm-3.1 3.1 1-1 1.5 1.5-1.5 1.5-1-1a.7.7 0 0 1 0-1Zm2.1 3.3 1.7 1.7c.2.3.6.3.9 0l1.7-1.7 1 1-2.2 2.2a1.5 1.5 0 0 1-2.1 0l-2.1-2.2 1-1Zm4.3-2.2 1.5-1.5 1 1c.3.3.3.7 0 1l-1 1-1.5-1.5Z"/><text x="19" y="15.2" fill="#4D4D4D" font-family="Arial, sans-serif" font-size="8" font-weight="700">pix</text></svg>
    </li>
  {%- endif -%}
  {%- if show_boleto -%}
    <li>
      <svg class="payment-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 38 24" width="38" height="24" role="img" aria-labelledby="pi-boleto-theme"><title id="pi-boleto-theme">Boleto</title><rect x=".5" y=".5" width="37" height="23" rx="2.5" fill="#fff" stroke="#000" stroke-opacity=".07"/><path fill="#222" d="M7 5h1v9H7zm2 0h.5v9H9zm1.5 0h1.5v9h-1.5zm2.5 0h.5v9H13zm1.5 0h1v9h-1zm2 0h.5v9h-.5zm1.5 0h1.5v9H18zm2.5 0h.5v9H20.5zm1.5 0h1v9h-1zm2 0h.5v9H24zm1.5 0h1.5v9h-1.5zm2.5 0h.5v9H28zm1.5 0h1v9h-1z"/><text x="19" y="20.2" fill="#222" font-family="Arial, sans-serif" font-size="4.6" font-weight="700" text-anchor="middle" letter-spacing=".3">BOLETO</text></svg>
    </li>
  {%- endif -%}
</ul>

{% stylesheet %}
  .payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .payment-icons__icon {
    width: 2.625rem;
    height: auto;
  }
{% endstylesheet %}

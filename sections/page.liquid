<article class="main-page page-width section-spacing">
  <header class="section-header">
    <h1>{{ page.title }}</h1>
  </header>
  <div class="main-page__content rte">{{ page.content }}</div>
</article>

{% stylesheet %}
  .main-page__content {
    max-width: 48rem;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Página",
  "settings": []
}
{% endschema %}

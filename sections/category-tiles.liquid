<section
  class="category-tiles full-width section-spacing"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --columns: {{ section.settings.columns }};"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="category-tiles__grid">
      {%- for block in section.blocks -%}
        <article class="category-tile category-tile--{{ section.settings.style }} reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 120 }}ms;">
          <a href="{{ block.settings.button_link_1 | default: '#' }}" class="category-tile__media media" tabindex="-1" aria-hidden="true">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 750px) 50vw, 100vw' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="category-tile__content">
            {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h3 class="category-tile__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<div class="category-tile__text">{{ block.settings.text }}</div>{%- endif -%}
            <div class="buttons category-tile__buttons">
              {%- if block.settings.button_label_1 != blank -%}
                <a href="{{ block.settings.button_link_1 | default: '#' }}" class="button{% if section.settings.style == 'overlay' %} button--light{% endif %}">{{ block.settings.button_label_1 }}</a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a href="{{ block.settings.button_link_2 | default: '#' }}" class="link">{{ block.settings.button_label_2 }}</a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .category-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 3rem 1.5rem;
  }

  .category-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .category-tile__media {
    display: block;
    aspect-ratio: 4 / 5;
  }

  .category-tile__media img {
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .category-tile:hover .category-tile__media img {
    transform: scale(1.05);
  }

  .category-tile__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
  }

  .category-tile__text {
    max-width: 30rem;
    color: var(--color-muted);
  }

  .category-tile__buttons {
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-block-start: 0.5rem;
  }

  .category-tile--overlay .category-tile__content {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1.5rem;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent);
    pointer-events: none;
  }

  .category-tile--overlay .category-tile__content a {
    pointer-events: auto;
  }

  .category-tile--overlay .category-tile__text,
  .category-tile--overlay .eyebrow {
    color: rgb(255 255 255 / 0.85);
  }

  @media (max-width: 749px) {
    .category-tiles__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blocos de categoria",
  "class": "section-category-tiles",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "range", "id": "columns", "label": "Colunas no desktop", "min": 1, "max": 3, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "below", "label": "Texto abaixo da imagem" },
        { "value": "overlay", "label": "Texto sobre a imagem" }
      ],
      "default": "below"
    },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
        { "type": "text", "id": "title", "label": "Título", "default": "Diamantes" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Explore a maior seleção de diamantes certificados.</p>" },
        { "type": "text", "id": "button_label_1", "label": "Botão - texto", "default": "Comprar" },
        { "type": "url", "id": "button_link_1", "label": "Botão - link" },
        { "type": "text", "id": "button_label_2", "label": "Link secundário - texto", "default": "Saiba mais" },
        { "type": "url", "id": "button_link_2", "label": "Link secundário - link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blocos de categoria",
      "blocks": [
        { "type": "tile", "settings": { "title": "Diamantes", "text": "<p>Explore a maior seleção de diamantes certificados.</p>" } },
        { "type": "tile", "settings": { "title": "Pedras preciosas", "text": "<p>As cores mais vibrantes da natureza: safiras, esmeraldas e rubis.</p>" } },
        { "type": "tile", "settings": { "title": "Diamantes de laboratório", "text": "<p>Brilho, simetria e pureza excepcionais, com consciência.</p>" } },
        { "type": "tile", "settings": { "title": "Diamantes naturais", "text": "<p>Os diamantes naturais do mais alto calibre, selecionados um a um.</p>" } }
      ]
    }
  ]
}
{% endschema %}

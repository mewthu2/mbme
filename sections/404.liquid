<div class="not-found page-width section-spacing">
  <span class="eyebrow">404</span>
  <h1>{{ '404.title' | t }}</h1>
  <p>{{ '404.not_found' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="button">{{ '404.back_to_shopping' | t }}</a>
</div>

{% stylesheet %}
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block: 6rem;
    text-align: center;
  }

  .not-found p {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Página não encontrada",
  "settings": []
}
{% endschema %}

<div class="search-page page-width section-spacing" style="--columns: 4;">
  <div class="section-header">
    <h1>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label class="visually-hidden" for="SearchPageInput">{{ 'search.title' | t }}</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" class="input">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.filters.size > 0 -%}
        {% render 'facets', results: search, count: search.results_count, terms: search.terms %}
      {%- else -%}
        <p class="search-page__count">{{ 'search.results_for_html' | t: count: search.results_count, terms: search.terms }}</p>
      {%- endif -%}

      {%- if search.results_count == 0 -%}
        <p class="search-page__empty">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {%- else -%}
        <ul class="product-grid" role="list">
          {%- for item in search.results -%}
            <li class="product-grid__item">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- when 'article' -%}
                  {% render 'article-card', article: item %}
                {%- when 'page' -%}
                  <a href="{{ item.url }}" class="search-page__page">
                    <span class="eyebrow">{{ 'search.page' | t }}</span>
                    <span class="h4">{{ item.title }}</span>
                    <span>{{ item.content | strip_html | truncatewords: 20 }}</span>
                  </a>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page__form {
    display: flex;
    width: min(100%, 36rem);
    margin-block-start: 1rem;
  }

  .search-page__form .button {
    padding-inline: 1.25rem;
  }

  .search-page__count,
  .search-page__empty {
    margin-block-end: 2rem;
    text-align: center;
    color: var(--color-muted);
  }

  .search-page .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 3rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .search-page__page {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 2rem;
    background: var(--color-surface);
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .search-page .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Busca",
  "settings": []
}
{% endschema %}

{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
-%}

<section
  class="hero full-width hero--{{ section.settings.height }} hero--{{ section.settings.content_position }}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text: {{ section.settings.text_color }};"
>
  <div class="hero__media">
    {%- if image -%}
      <picture>
        {%- if section.settings.mobile_image -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w" sizes="100vw">
        {%- endif -%}
        {{ image | image_url: width: 3000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2200, 2600, 3000', sizes: '100vw', class: 'hero__image' }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero__image' }}
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hero__heading h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero__subheading">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="buttons hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="button button--light">{{ section.settings.button_label_1 }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}" class="button button--outline-light">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--hero-text);
    background: var(--color-dark);
  }

  .hero--small {
    min-height: 26rem;
  }

  .hero--medium {
    min-height: min(40rem, 80svh);
  }

  .hero--large {
    min-height: min(52rem, 90svh);
  }

  .hero--full {
    min-height: calc(100svh - 7rem);
  }

  .hero__media,
  .hero__content {
    grid-area: 1 / 1;
  }

  .hero__media {
    position: relative;
    height: 100%;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / var(--hero-overlay)), rgb(0 0 0 / calc(var(--hero-overlay) * 0.35)));
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom 12s ease-out both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    padding-block: 4rem;
  }

  .hero--bottom-left .hero__content {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .hero--middle-left .hero__content {
    align-items: center;
    justify-content: flex-start;
  }

  .hero--middle-center .hero__content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero--bottom-center .hero__content {
    align-items: flex-end;
    justify-content: center;
    text-align: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 38rem;
    animation: hero-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) both 0.2s;
  }

  .hero--middle-center .hero__text,
  .hero--bottom-center .hero__text {
    align-items: center;
  }

  .hero__eyebrow {
    color: inherit;
  }

  .hero__heading {
    font-size: calc(clamp(2.5rem, 6vw, 5rem) * var(--font-heading--scale));
    line-height: 1.05;
  }

  .hero__subheading {
    font-size: 1.0625rem;
    max-width: 32rem;
  }

  .hero__buttons {
    margin-block-start: 0.5rem;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @media (max-width: 749px) {
    .hero__content {
      padding-block: 2.5rem;
    }

    .hero__buttons .button {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner principal",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Imagem (celular)", "info": "Opcional. Recomendado formato retrato." },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "small", "label": "Pequena" },
        { "value": "medium", "label": "Média" },
        { "value": "large", "label": "Grande" },
        { "value": "full", "label": "Tela cheia" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posição do conteúdo",
      "options": [
        { "value": "bottom-left", "label": "Inferior esquerda" },
        { "value": "middle-left", "label": "Centro esquerda" },
        { "value": "middle-center", "label": "Centro" },
        { "value": "bottom-center", "label": "Inferior centro" }
      ],
      "default": "middle-left"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Escurecer imagem", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Nova coleção" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Capture a luz" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Joias criadas com excelência para o seu momento. Agora com até 30% de desconto.</p>" },
    { "type": "text", "id": "button_label_1", "label": "Botão 1 - texto", "default": "Anéis de noivado" },
    { "type": "url", "id": "button_link_1", "label": "Botão 1 - link" },
    { "type": "text", "id": "button_label_2", "label": "Botão 2 - texto", "default": "Joias com diamantes" },
    { "type": "url", "id": "button_link_2", "label": "Botão 2 - link" }
  ],
  "presets": [{ "name": "Banner principal" }]
}
{% endschema %}

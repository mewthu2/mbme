<article class="article-page section-spacing">
  <header class="article-page__header page-width">
    <nav aria-label="{{ 'general.breadcrumbs' | t }}">
      <ol class="breadcrumbs">
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
      </ol>
    </nav>
    <h1>{{ article.title }}</h1>
    {%- assign date = article.published_at | time_tag: format: 'date' -%}
    <p class="article-page__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
  </header>

  {%- if article.image -%}
    <div class="article-page__image media">
      {{ article.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '(min-width: 1200px) 1200px, 100vw' }}
    </div>
  {%- endif -%}

  <div class="article-page__content rte">{{ article.content }}</div>

  {%- if article.tags.size > 0 -%}
    <ul class="article-page__tags" role="list">
      {%- for tag in article.tags -%}
        <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}">#{{ tag }}</a></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="article-page__comments" id="comments">
      <h2 class="h3">{{ 'blog.article_comments' | t }} ({{ article.comments_count }})</h2>
      {%- paginate article.comments by 10 -%}
        {%- for comment in article.comments -%}
          <div class="article-page__comment">
            <p class="article-page__comment-author">{{ comment.author }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            <div class="rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article, class: 'article-page__form' -%}
        <h3 class="h4">{{ 'blog.comment_form_title' | t }}</h3>
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">
            {%- if blog.moderated? -%}{{ 'blog.comment_moderated' | t }}{%- else -%}{{ 'blog.comment_posted' | t }}{%- endif -%}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="article-page__fields">
          <div class="field">
            <label for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
            <input type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
            <input type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>
        <div class="field">
          <label for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
          <textarea name="comment[body]" id="CommentBody" rows="5" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="button">{{ 'blog.comment_form_submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% stylesheet %}
  .article-page__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 52rem;
    margin-block-end: 3rem;
    text-align: center;
  }

  .article-page__meta {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .article-page__image {
    max-width: 75rem;
    width: 100%;
    margin: 0 auto 3rem;
    aspect-ratio: 16 / 9;
  }

  .article-page__content,
  .article-page__tags,
  .article-page__comments {
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .article-page__content {
    font-size: 1.0625rem;
  }

  .article-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2.5rem;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .article-page__comments {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 4rem;
    padding-block-start: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .article-page__comment {
    padding-block-end: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-page__comment-author {
    margin-block-end: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .article-page__form {
    display: grid;
    gap: 1.25rem;
  }

  .article-page__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 749px) {
    .article-page__fields {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artigo",
  "settings": []
}
{% endschema %}

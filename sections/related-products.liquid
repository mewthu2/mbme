<product-recommendations
  class="related-products full-width section-spacing"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <scroll-slider class="page-width related-products__inner">
      <div class="featured-collection__header">
        <h2>{{ section.settings.heading }}</h2>
        <div class="slider-controls">
          <button type="button" class="slider-button" data-slider-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="slider-button" data-slider-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
      <ul class="scroll-track related-products__list" role="list" data-slider-track>
        {%- for product in recommendations.products -%}
          <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 70vw' %}</li>
        {%- endfor -%}
      </ul>
    </scroll-slider>
  {%- endif -%}
</product-recommendations>

{% stylesheet %}
  .related-products {
    display: block;
    border-top: 1px solid var(--color-border);
  }

  .related-products:empty {
    display: none;
  }

  .related-products__inner {
    display: block;
  }

  .related-products__list {
    --track-item-width: calc((100% - 4.5rem) / 4);
    --track-gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 989px) {
    .related-products__list {
      --track-item-width: 42%;
    }
  }

  @media (max-width: 749px) {
    .related-products__list {
      --track-item-width: 70%;
      --track-gap: 1rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    connectedCallback() {
      if (this.dataset.loaded) return;
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          this.load();
        },
        { rootMargin: '0px 0px 400px 0px' }
      );
      observer.observe(this);
    }

    async load() {
      this.dataset.loaded = 'true';
      const response = await fetch(this.dataset.url);
      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.querySelector('product-recommendations');
      if (fresh && fresh.innerHTML.trim().length) this.innerHTML = fresh.innerHTML;
    }
  }

  if (!customElements.get('product-recommendations')) customElements.define('product-recommendations', ProductRecommendations);
{% endjavascript %}

{% schema %}
{
  "name": "Produtos relacionados",
  "class": "section-related-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Você também pode gostar" },
    { "type": "range", "id": "products_to_show", "label": "Quantidade de produtos", "min": 2, "max": 10, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo de recomendação",
      "options": [
        { "value": "related", "label": "Relacionados" },
        { "value": "complementary", "label": "Complementares" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

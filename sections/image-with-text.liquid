<section
  class="image-with-text full-width color-scheme--{{ section.settings.color_scheme }} image-with-text--{{ section.settings.layout }}{% unless section.settings.full_bleed %} section-spacing{% endunless %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__inner{% unless section.settings.full_bleed %} page-width{% endunless %}">
    <div class="image-with-text__media media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '(min-width: 990px) 60vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="image-with-text__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button">{{ section.settings.button_label_1 }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .image-with-text__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
  }

  .image-with-text--image-right .image-with-text__media {
    order: 2;
  }

  .image-with-text__media {
    aspect-ratio: 4 / 3;
    height: 100%;
    background: var(--color-surface);
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .image-with-text__text {
    color: var(--color-muted);
  }

  .image-with-text .buttons {
    margin-block-start: 0.5rem;
  }

  .image-with-text--overlay .image-with-text__inner {
    grid-template-columns: 1fr;
  }

  .image-with-text--overlay .image-with-text__media,
  .image-with-text--overlay .image-with-text__content {
    grid-area: 1 / 1;
  }

  .image-with-text--overlay .image-with-text__media {
    aspect-ratio: 21 / 9;
    min-height: 32rem;
  }

  .image-with-text--overlay .image-with-text__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.35);
  }

  .image-with-text--overlay .image-with-text__content {
    position: relative;
    z-index: 1;
    align-items: center;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
    color: #fff;
    --color-foreground: #fff;
    --color-muted: rgb(255 255 255 / 0.85);
    --color-button: #fff;
    --color-button-text: #111;
  }

  .image-with-text--overlay .buttons {
    justify-content: center;
  }

  .image-with-text--overlay .eyebrow {
    color: #fff;
  }

  @media (max-width: 989px) {
    .image-with-text__inner {
      grid-template-columns: 1fr;
    }

    .image-with-text--image-right .image-with-text__media {
      order: 0;
    }

    .image-with-text__content {
      padding: 2.5rem var(--page-margin);
    }

    .image-with-text--overlay .image-with-text__media {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Imagem com texto",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Imagem à esquerda" },
        { "value": "image-right", "label": "Imagem à direita" },
        { "value": "overlay", "label": "Texto sobre a imagem" }
      ],
      "default": "image-left"
    },
    { "type": "checkbox", "id": "full_bleed", "label": "Largura total (sem margens)", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "surface", "label": "Claro" },
        { "value": "dark", "label": "Escuro" }
      ],
      "default": "surface"
    },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Sob medida" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Uma joia só sua" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Com nosso serviço de encomenda exclusiva, nossos especialistas transformam sua ideia em uma peça única e inimitável, do primeiro esboço ao acabamento final.</p>" },
    { "type": "text", "id": "button_label_1", "label": "Botão 1 - texto", "default": "Criar sob medida" },
    { "type": "url", "id": "button_link_1", "label": "Botão 1 - link" },
    { "type": "text", "id": "button_label_2", "label": "Botão 2 - texto" },
    { "type": "url", "id": "button_link_2", "label": "Botão 2 - link" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Imagem com texto" }]
}
{% endschema %}

<section
  class="shop-by-shape full-width section-spacing"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="shop-by-shape__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="shop-by-shape__item">
            <span class="shop-by-shape__media">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.label, widths: '150, 300', sizes: '120px' }}
              {%- else -%}
                {% render 'icon', name: 'diamond' %}
              {%- endif -%}
            </span>
            <span class="shop-by-shape__label">{{ block.settings.label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .shop-by-shape__list {
    display: flex;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .shop-by-shape__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    min-width: 5.5rem;
    text-decoration: none;
  }

  .shop-by-shape__media {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    transition: transform 0.4s ease;
  }

  .shop-by-shape__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shop-by-shape__media .icon {
    width: 3rem;
    height: 3rem;
    color: var(--color-muted);
  }

  .shop-by-shape__item:hover .shop-by-shape__media {
    transform: translateY(-4px);
  }

  .shop-by-shape__label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 989px) {
    .shop-by-shape__list {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comprar por formato",
  "class": "section-shop-by-shape",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar por formato" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Formato",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (PNG transparente)" },
        { "type": "text", "id": "label", "label": "Nome", "default": "Redondo" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar por formato",
      "blocks": [
        { "type": "shape", "settings": { "label": "Redondo" } },
        { "type": "shape", "settings": { "label": "Oval" } },
        { "type": "shape", "settings": { "label": "Princesa" } },
        { "type": "shape", "settings": { "label": "Esmeralda" } },
        { "type": "shape", "settings": { "label": "Pera" } },
        { "type": "shape", "settings": { "label": "Coração" } },
        { "type": "shape", "settings": { "label": "Almofada" } },
        { "type": "shape", "settings": { "label": "Marquise" } }
      ]
    }
  ]
}
{% endschema %}

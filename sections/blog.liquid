<div class="blog-page page-width section-spacing">
  <header class="section-header">
    <h1>{{ blog.title }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <ul class="blog-page__tags" role="list">
        <li><a href="{{ blog.url }}" {% unless current_tags %}aria-current="page"{% endunless %}>{{ 'blog.all' | t }}</a></li>
        {%- for tag in blog.all_tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>{{ tag }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </header>

  {%- paginate blog.articles by 9 -%}
    <ul class="blog-page__grid" role="list">
      {%- for article in blog.articles -%}
        <li>{% render 'article-card', article: article %}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .blog-page__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .blog-page__tags a {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .blog-page__tags a[aria-current] {
    border-color: var(--color-foreground);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 989px) {
    .blog-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .blog-page__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}

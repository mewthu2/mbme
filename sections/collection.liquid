<div class="collection-page full-width" style="--columns: {{ section.settings.columns }};">
  {%- if section.settings.show_banner -%}
    <header class="collection-banner{% if collection.image and section.settings.show_image %} collection-banner--image{% endif %}">
      {%- if collection.image and section.settings.show_image -%}
        <div class="collection-banner__media">
          {{ collection.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw' }}
        </div>
      {%- endif -%}
      <div class="collection-banner__content page-width">
        <nav aria-label="{{ 'general.breadcrumbs' | t }}">
          <ol class="breadcrumbs">
            <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
            <li aria-current="page">{{ collection.title }}</li>
          </ol>
        </nav>
        <h1>{{ collection.title }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="collection-banner__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </header>
  {%- endif -%}

  <div class="page-width collection-page__body">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_filtering -%}
        {% render 'facets', results: collection, count: collection.products_count %}
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li class="product-grid__item">
              {%- if forloop.index <= 4 -%}
                {% render 'product-card', product: product, lazy: false, sizes: '(min-width: 990px) 25vw, 50vw' %}
              {%- else -%}
                {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="collection-page__empty">
          <p>{{ 'collections.empty' | t }}</p>
          <a href="{{ collection.url }}" class="button button--secondary">{{ 'collections.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: grid;
    padding-block: 3rem 2.5rem;
    text-align: center;
  }

  .collection-banner__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .collection-banner__description {
    max-width: 44rem;
    color: var(--color-muted);
  }

  .collection-banner--image {
    min-height: 22rem;
    align-items: end;
    padding-block: 0;
    color: #fff;
  }

  .collection-banner--image > * {
    grid-area: 1 / 1;
  }

  .collection-banner--image .collection-banner__media {
    position: relative;
  }

  .collection-banner--image .collection-banner__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner--image .collection-banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.35);
  }

  .collection-banner--image .collection-banner__content {
    position: relative;
    padding-block: 4rem 3rem;
    --color-muted: rgb(255 255 255 / 0.85);
  }

  .collection-banner--image .breadcrumbs {
    color: rgb(255 255 255 / 0.85);
  }

  .collection-page__body {
    padding-block: 1rem 5rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 3rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .collection-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-block: 4rem;
    text-align: center;
  }

  @media (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coleção",
  "class": "section-collection",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Mostrar cabeçalho", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Mostrar imagem da coleção", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descrição", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "Ativar filtros e ordenação", "default": true, "info": "Configure os filtros no app Search & Discovery." },
    { "type": "range", "id": "products_per_page", "label": "Produtos por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Colunas no desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}

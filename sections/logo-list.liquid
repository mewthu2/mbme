<section
  class="logo-list full-width section-spacing color-scheme--{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="logo-list__heading eyebrow">{{ section.settings.heading }}</p>
    {%- endif -%}
    <ul class="logo-list__items" role="list">
      {%- for block in section.blocks -%}
        <li class="logo-list__item" {{ block.shopify_attributes }}>
          {%- capture logo -%}
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, widths: '200, 400', sizes: '160px' }}
            {%- else -%}
              <span class="logo-list__name">{{ block.settings.name }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ logo }}</a>
          {%- else -%}
            {{ logo }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .logo-list__heading {
    margin-block-end: 2rem;
    text-align: center;
    color: var(--color-muted);
  }

  .logo-list__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem 4rem;
    padding: 0;
    list-style: none;
  }

  .logo-list__item img {
    width: auto;
    max-width: 10rem;
    max-height: 2.5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .logo-list__item:hover img {
    filter: none;
    opacity: 1;
  }

  .logo-list__name {
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    color: var(--color-muted);
  }

  .logo-list__item a {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logos (imprensa)",
  "class": "section-logo-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Como visto em" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "surface", "label": "Claro" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Nome", "default": "Revista" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos (imprensa)",
      "blocks": [
        { "type": "logo", "settings": { "name": "Vogue" } },
        { "type": "logo", "settings": { "name": "Forbes" } },
        { "type": "logo", "settings": { "name": "Elle" } },
        { "type": "logo", "settings": { "name": "Marie Claire" } },
        { "type": "logo", "settings": { "name": "Harper's Bazaar" } }
      ]
    }
  ]
}
{% endschema %}

<section
  class="faq full-width section-spacing color-scheme--{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width faq__inner">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }} name="faq-{{ section.id }}">
          <summary class="accordion__summary">
            <span>{{ block.settings.question }}</span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq__list {
    max-width: 50rem;
    margin-inline: auto;
    border-top: 1px solid var(--color-border);
  }

  .accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary .icon {
    transition: transform 0.3s ease;
  }

  .accordion[open] > .accordion__summary .icon {
    transform: rotate(45deg);
  }

  .accordion__content {
    padding-block-end: 1.5rem;
    color: var(--color-muted);
  }

  .accordion::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.35s ease, content-visibility 0.35s allow-discrete;
  }

  .accordion[open]::details-content {
    block-size: auto;
  }

  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Perguntas frequentes",
  "class": "section-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Ajuda" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Perguntas frequentes" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "surface", "label": "Claro" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "Os diamantes possuem certificado?" },
        { "type": "richtext", "id": "answer", "label": "Resposta", "default": "<p>Sim. Todos os diamantes acima de 0,30 ct acompanham certificado de laboratório gemológico independente.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Qual o prazo de entrega?", "answer": "<p>Peças em estoque são enviadas em até 3 dias úteis. Peças sob encomenda levam de 3 a 5 semanas.</p>" } },
        { "type": "question", "settings": { "question": "Posso ajustar o tamanho do anel?", "answer": "<p>Sim, o primeiro ajuste de aro é gratuito em até 60 dias após a compra.</p>" } },
        { "type": "question", "settings": { "question": "Como funciona a troca?", "answer": "<p>Você tem até 30 dias para trocar ou devolver sua peça, sem custo.</p>" } }
      ]
    }
  ]
}
{% endschema %}

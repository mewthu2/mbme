<div class="password page-width">
  <div class="password__inner">
    <span class="password__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </span>
    <h1>{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {% render 'newsletter-form', id: 'PasswordNewsletter' %}

    <details class="password__login">
      <summary class="link">{{ 'password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label for="password-input">{{ 'password.password' | t }}</label>
          <input type="password" name="password" id="password-input" autocomplete="current-password" required>
        </div>
        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .password {
    display: grid;
    place-items: center;
    min-height: 100svh;
    text-align: center;
  }

  .password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: min(100%, 32rem);
  }

  .password__inner .newsletter-form {
    width: 100%;
  }

  .password__logo {
    width: var(--logo-width);
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .password__login summary {
    list-style: none;
  }

  .password__form {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.5rem;
    text-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Senha",
  "settings": []
}
{% endschema %}

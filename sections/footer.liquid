<footer class="site-footer full-width color-scheme--{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div class="site-footer__block site-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <a href="{{ routes.root_url }}" class="site-footer__logo">
                {%- if settings.logo_inverse and section.settings.color_scheme == 'dark' -%}
                  {{ settings.logo_inverse | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
                {%- elsif settings.logo and section.settings.color_scheme != 'dark' -%}
                  {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
                {%- else -%}
                  <span>{{ shop.name }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {% render 'social-icons' %}
              {%- endif -%}
            {%- when 'menu' -%}
              <details class="site-footer__details" open>
                <summary class="site-footer__heading">
                  {{ block.settings.heading | default: block.settings.menu.title }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <ul class="site-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- when 'text' -%}
              <h2 class="site-footer__heading site-footer__heading--static">{{ block.settings.heading }}</h2>
              <div class="site-footer__text rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              <h2 class="site-footer__heading site-footer__heading--static">{{ block.settings.heading }}</h2>
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {% render 'newsletter-form', id: 'FooterNewsletter' %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
        {%- if section.settings.legal_text != blank -%}
          <div class="site-footer__legal-text">{{ section.settings.legal_text }}</div>
        {%- endif -%}
        {%- if section.settings.legal_menu.links.size > 0 -%}
          <ul class="site-footer__legal-links" role="list">
            {%- for link in section.settings.legal_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="site-footer__meta">
        {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
          {% render 'localization-form', id: 'FooterLocalization' %}
        {%- endif -%}
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="site-footer__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding-block: 4.5rem 2rem;
    font-size: 0.875rem;
  }

  .site-footer.color-scheme--default {
    border-top: 1px solid var(--color-border);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2.5rem;
  }

  .site-footer__block--newsletter {
    min-width: 16rem;
  }

  .site-footer__block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__logo {
    display: inline-block;
    max-width: calc(var(--logo-width) * 1.1);
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-footer__text {
    color: var(--color-muted);
  }

  .site-footer__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.5rem;
    font-family: var(--font-primary--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    list-style: none;
    cursor: default;
  }

  .site-footer__heading::-webkit-details-marker {
    display: none;
  }

  .site-footer__heading .icon {
    display: none;
  }

  .site-footer__links {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__links a,
  .site-footer__legal-links a {
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .site-footer__links a:hover,
  .site-footer__legal-links a:hover {
    color: var(--color-foreground);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-start: 4rem;
    padding-block-start: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .site-footer__legal {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment-icon {
    width: 2.375rem;
    height: auto;
  }

  @media (max-width: 749px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .site-footer__block {
      padding-block: 1rem;
    }

    .site-footer__block--menu {
      border-bottom: 1px solid var(--color-border);
    }

    .site-footer__heading:not(.site-footer__heading--static) {
      margin: 0;
      cursor: pointer;
    }

    .site-footer__heading .icon {
      display: block;
      transition: transform 0.3s ease;
    }

    .site-footer__details[open] .icon {
      transform: rotate(45deg);
    }

    .site-footer__links {
      padding-block: 1rem 0.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  const footerAccordions = () => {
    const mobile = window.matchMedia('(max-width: 749px)').matches;
    document.querySelectorAll('.site-footer__details').forEach((details) => {
      details.open = !mobile;
    });
  };
  footerAccordions();
  window.matchMedia('(max-width: 749px)').addEventListener('change', footerAccordions);
  document.addEventListener('shopify:section:load', footerAccordions);
  document.addEventListener('click', (event) => {
    const summary = event.target.closest('.site-footer__details > summary');
    if (summary && !window.matchMedia('(max-width: 749px)').matches) event.preventDefault();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "surface", "label": "Claro" },
        { "value": "dark", "label": "Escuro" }
      ],
      "default": "dark"
    },
    { "type": "richtext", "id": "legal_text", "label": "Informações da empresa", "default": "<p>Razão social · CNPJ 00.000.000/0001-00 · Endereço completo</p>" },
    { "type": "link_list", "id": "legal_menu", "label": "Menu legal (privacidade, termos)" },
    { "type": "checkbox", "id": "show_localization", "label": "Mostrar seletor de país/moeda", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar ícones de pagamento", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Joias finas e diamantes certificados, criados com excelência artesanal.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociais", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Atendimento" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Seg. a sex., 9h às 18h<br>contato@sualoja.com.br</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Vamos manter contato" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Novidades e ofertas exclusivas no seu e-mail.</p>" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}

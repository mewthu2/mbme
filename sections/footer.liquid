{%- liquid
  assign brand_blocks = section.blocks | where: 'type', 'brand'
  assign column_count = section.blocks.size | minus: brand_blocks.size
  assign has_brand = false
  if brand_blocks.size > 0
    assign has_brand = true
  endif
  assign show_social = false
  if section.settings.show_social
    assign show_social = true
  endif
-%}

<footer class="site-footer full-width color-scheme--{{ section.settings.color_scheme }}">
  {%- if section.settings.show_newsletter -%}
    <div class="site-footer__newsletter">
      <div class="page-width site-footer__newsletter-inner">
        <div class="site-footer__newsletter-text">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="site-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="site-footer__muted rte">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}
        </div>
        {% render 'newsletter-form', id: 'FooterNewsletter' %}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="page-width">
      <div
        class="site-footer__main{% if has_brand %} site-footer__main--has-brand{% endif %}"
        style="--footer-columns: {{ column_count | at_least: 1 }};"
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="site-footer__brand" {{ block.shopify_attributes }}>
                <a href="{{ routes.root_url }}" class="site-footer__logo">
                  {%- if settings.logo_inverse and section.settings.color_scheme == 'dark' -%}
                    {{ settings.logo_inverse | image_url: width: 500 | image_tag: alt: shop.name, loading: 'lazy' }}
                  {%- elsif settings.logo and section.settings.color_scheme != 'dark' -%}
                    {{ settings.logo | image_url: width: 500 | image_tag: alt: shop.name, loading: 'lazy' }}
                  {%- else -%}
                    <span>{{ shop.name }}</span>
                  {%- endif -%}
                </a>
                {%- if block.settings.text != blank -%}
                  <div class="site-footer__muted rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons', class: 'social-icons--circle', include_whatsapp: true %}
                {%- endif -%}
              </div>

            {%- when 'image' -%}
              <div class="site-footer__column site-footer__column--image" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="site-footer__heading site-footer__heading--static">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="site-footer__image" style="--footer-image-width: {{ block.settings.width }}px;">
                  {%- if block.settings.image -%}
                    {%- capture seal -%}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px' }}{%- endcapture -%}
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ seal }}</a>
                    {%- else -%}
                      {{ seal }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>

            {%- else -%}
              {%- liquid
                case block.type
                  when 'menu'
                    assign column_heading = block.settings.heading | default: block.settings.menu.title
                  else
                    assign column_heading = block.settings.heading
                endcase
              -%}
              <div class="site-footer__column" data-footer-column {{ block.shopify_attributes }}>
                <h2 class="site-footer__heading">
                  <button type="button" class="site-footer__toggle" aria-expanded="false" aria-controls="FooterColumn-{{ block.id }}">
                    <span>{{ column_heading }}</span>
                    {% render 'icon', name: 'plus' %}
                  </button>
                </h2>
                <div id="FooterColumn-{{ block.id }}" class="site-footer__collapsible">
                  {%- case block.type -%}
                    {%- when 'menu' -%}
                      <ul class="site-footer__links" role="list">
                        {%- for link in block.settings.menu.links -%}
                          <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'contact' -%}
                      <ul class="site-footer__contact" role="list">
                        {%- if block.settings.phone != blank -%}
                          <li>
                            {% render 'icon', name: 'phone' %}
                            <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ block.settings.phone }}</a>
                          </li>
                        {%- endif -%}
                        {%- if block.settings.show_whatsapp and settings.whatsapp_number != blank -%}
                          <li>
                            {% render 'icon', name: 'whatsapp' %}
                            <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener">{{ 'footer.whatsapp' | t }}</a>
                          </li>
                        {%- endif -%}
                        {%- if block.settings.email != blank -%}
                          <li>
                            {% render 'icon', name: 'mail' %}
                            <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                          </li>
                        {%- endif -%}
                        {%- if block.settings.hours != blank -%}
                          <li>
                            {% render 'icon', name: 'clock' %}
                            <span>{{ block.settings.hours | newline_to_br }}</span>
                          </li>
                        {%- endif -%}
                        {%- if block.settings.address != blank -%}
                          <li>
                            {% render 'icon', name: 'pin' %}
                            <span>{{ block.settings.address | newline_to_br }}</span>
                          </li>
                        {%- endif -%}
                      </ul>
                      {%- if block.settings.button_label != blank -%}
                        <a href="{{ block.settings.button_link | default: '#' }}" class="button button--secondary site-footer__contact-button">
                          {% render 'icon', name: 'calendar' %}
                          {{ block.settings.button_label }}
                        </a>
                      {%- endif -%}
                    {%- when 'text' -%}
                      <div class="site-footer__muted rte">{{ block.settings.text }}</div>
                  {%- endcase -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_payment_icons or section.settings.seal_1 != blank or section.settings.seal_2 != blank or show_social -%}
    <div class="page-width">
      <div class="site-footer__trust">
        {%- if section.settings.show_payment_icons -%}
          <div class="site-footer__trust-group">
            <h2 class="site-footer__label">{{ 'footer.payment_methods' | t }}</h2>
            {% render 'payment-icons',
              manual_list: section.settings.payment_list,
              force_manual: section.settings.payment_force_manual,
              show_pix: section.settings.show_pix,
              show_boleto: section.settings.show_boleto
            %}
            {%- if section.settings.installments_text != blank -%}
              <p class="site-footer__small">{{ section.settings.installments_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.seal_1 != blank or section.settings.seal_2 != blank -%}
          <div class="site-footer__trust-group">
            <h2 class="site-footer__label">{{ 'footer.security' | t }}</h2>
            <ul class="site-footer__seals" role="list">
              {%- if section.settings.seal_1 != blank -%}
                <li>{% render 'icon', name: 'shield' %}<span>{{ section.settings.seal_1 }}</span></li>
              {%- endif -%}
              {%- if section.settings.seal_2 != blank -%}
                <li>{% render 'icon', name: 'lock' %}<span>{{ section.settings.seal_2 }}</span></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_social -%}
          <div class="site-footer__trust-group">
            <h2 class="site-footer__label">
              {%- if section.settings.social_heading != blank -%}{{ section.settings.social_heading }}{%- else -%}{{ 'footer.follow_us' | t }}{%- endif -%}
            </h2>
            {% render 'social-icons', class: 'social-icons--circle', include_whatsapp: true %}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="site-footer__bottom">
      <div class="site-footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
        {%- if section.settings.legal_text != blank -%}
          <div class="site-footer__legal-text">{{ section.settings.legal_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.legal_menu.links.size > 0 -%}
        <ul class="site-footer__legal-links" role="list">
          {%- for link in section.settings.legal_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
        <div class="site-footer__localization">
          {% render 'localization-form', id: 'FooterLocalization' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    font-size: 0.875rem;
  }

  .site-footer.color-scheme--default {
    border-top: 1px solid var(--color-border);
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__muted {
    color: var(--color-muted);
  }

  .site-footer__newsletter {
    border-bottom: 1px solid var(--color-border);
  }

  .site-footer__newsletter-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
    align-items: center;
    gap: 2rem 4rem;
    padding-block: 3.5rem;
  }

  .site-footer__newsletter-text {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__newsletter-heading {
    font-size: calc(clamp(1.5rem, 2.4vw, 2rem) * var(--font-heading--scale));
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: repeat(var(--footer-columns), minmax(0, 1fr));
    gap: 2.5rem;
    padding-block: 4rem 3.5rem;
  }

  .site-footer__main--has-brand {
    grid-template-columns: minmax(0, 1.5fr) repeat(var(--footer-columns), minmax(0, 1fr));
    column-gap: clamp(2rem, 4vw, 4rem);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 22rem;
  }

  .site-footer__logo {
    display: inline-block;
    width: calc(var(--logo-width) * 1.1);
    max-width: 100%;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .site-footer__logo span {
    white-space: nowrap;
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .site-footer__heading {
    margin-block-end: 1.25rem;
    font-family: var(--font-primary--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .site-footer__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: start;
    color: inherit;
    cursor: default;
  }

  .site-footer__toggle .icon {
    display: none;
  }

  .site-footer__links {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__contact a,
  .site-footer__legal-links a {
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .site-footer__links a:hover,
  .site-footer__contact a:hover,
  .site-footer__legal-links a:hover {
    color: var(--color-foreground);
  }

  .site-footer__contact {
    display: grid;
    gap: 0.875rem;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
  }

  .site-footer__contact li {
    display: grid;
    grid-template-columns: 1.125rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .site-footer__contact .icon {
    width: 1.125rem;
    height: 1.125rem;
    margin-block-start: 0.15rem;
    color: var(--color-accent);
  }

  .site-footer__contact-button {
    margin-block-start: 1.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    align-self: flex-start;
  }

  .site-footer__image {
    width: var(--footer-image-width);
    max-width: 100%;
  }

  .site-footer__image .placeholder-svg {
    aspect-ratio: 3 / 2;
  }

  .site-footer__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--color-border);
  }

  .site-footer__trust-group {
    display: grid;
    align-content: start;
    gap: 0.875rem;
  }

  .site-footer__label {
    font-family: var(--font-primary--family);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-footer__small {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .site-footer__seals {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__seals li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .site-footer__seals .icon {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .site-footer__legal {
    display: grid;
    gap: 0.25rem;
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1199px) {
    .site-footer__main--has-brand {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .site-footer__main--has-brand .site-footer__brand {
      grid-column: 1 / -1;
      max-width: 32rem;
    }
  }

  @media (max-width: 749px) {
    .site-footer__newsletter-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-block: 2.5rem;
      text-align: center;
    }

    .site-footer__main,
    .site-footer__main--has-brand {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 1rem 2rem;
    }

    .site-footer__brand {
      align-items: center;
      max-width: none;
      padding-block: 2rem;
      text-align: center;
    }

    .site-footer__column {
      border-bottom: 1px solid var(--color-border);
    }

    .site-footer__column--image {
      align-items: center;
      padding-block: 1.5rem;
      border-bottom: 0;
    }

    .site-footer__heading {
      margin: 0;
    }

    .site-footer__column--image .site-footer__heading {
      margin-block-end: 1rem;
    }

    .site-footer__toggle {
      min-height: 3.5rem;
      cursor: pointer;
    }

    .site-footer__toggle .icon {
      display: block;
      width: 1rem;
      height: 1rem;
      transition: transform 0.3s ease;
    }

    .site-footer__toggle[aria-expanded='true'] .icon {
      transform: rotate(45deg);
    }

    .site-footer__collapsible {
      padding-block-end: 1.5rem;
    }

    .js .site-footer__column:not(.is-open) .site-footer__collapsible {
      display: none;
    }

    .site-footer__trust {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      border-top: 0;
      text-align: center;
    }

    .site-footer__trust-group {
      justify-items: center;
    }

    .site-footer__trust .payment-icons,
    .site-footer__trust .social-icons {
      justify-content: center;
    }

    .site-footer__bottom {
      flex-direction: column;
      text-align: center;
    }

    .site-footer__legal-links {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FooterAccordion {
    static mobile = window.matchMedia('(max-width: 749px)');

    static sync(root = document) {
      root.querySelectorAll('[data-footer-column]').forEach((column) => {
        const toggle = column.querySelector('.site-footer__toggle');
        if (!toggle) return;
        if (FooterAccordion.mobile.matches) {
          toggle.removeAttribute('tabindex');
          toggle.setAttribute('aria-expanded', column.classList.contains('is-open') ? 'true' : 'false');
        } else {
          column.classList.remove('is-open');
          toggle.setAttribute('tabindex', '-1');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    }
  }

  document.addEventListener('click', (event) => {
    const toggle = event.target.closest('.site-footer__toggle');
    if (!toggle || !FooterAccordion.mobile.matches) return;
    const column = toggle.closest('[data-footer-column]');
    const open = !column.classList.contains('is-open');
    column.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  FooterAccordion.sync();
  FooterAccordion.mobile.addEventListener('change', () => FooterAccordion.sync());
  document.addEventListener('shopify:section:load', (event) => FooterAccordion.sync(event.target));
  document.addEventListener('shopify:block:select', (event) => {
    const column = event.target.closest?.('[data-footer-column]');
    if (!column || !FooterAccordion.mobile.matches) return;
    column.classList.add('is-open');
    FooterAccordion.sync(column.parentElement);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "surface", "label": "Claro" },
        { "value": "dark", "label": "Escuro" }
      ],
      "default": "dark"
    },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar faixa de newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Título", "default": "Vamos manter contato" },
    { "type": "richtext", "id": "newsletter_text", "label": "Texto", "default": "<p>Receba lançamentos, ofertas exclusivas e conteúdos sobre joias em primeira mão.</p>" },
    { "type": "header", "content": "Redes sociais" },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociais", "default": true, "info": "Os links são configurados em Configurações do tema > Redes sociais." },
    { "type": "text", "id": "social_heading", "label": "Título", "default": "Siga-nos" },
    { "type": "header", "content": "Formas de pagamento" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar formas de pagamento", "default": true },
    { "type": "checkbox", "id": "show_pix", "label": "Mostrar Pix", "default": true },
    { "type": "checkbox", "id": "show_boleto", "label": "Mostrar boleto", "default": true },
    {
      "type": "text",
      "id": "payment_list",
      "label": "Bandeiras (lista manual)",
      "default": "visa,master,american_express,elo,hipercard,diners_club",
      "info": "Usada quando a loja ainda não tem pagamentos ativos. Separe por vírgula. Ex.: visa, master, american_express, elo, hipercard, diners_club, apple_pay, google_pay, paypal."
    },
    { "type": "checkbox", "id": "payment_force_manual", "label": "Sempre usar a lista manual", "default": false },
    { "type": "text", "id": "installments_text", "label": "Texto de parcelamento", "default": "Parcele em até 10x sem juros no cartão" },
    { "type": "header", "content": "Segurança" },
    { "type": "text", "id": "seal_1", "label": "Selo 1", "default": "Compra 100% segura" },
    { "type": "text", "id": "seal_2", "label": "Selo 2", "default": "Site protegido com certificado SSL" },
    { "type": "header", "content": "Rodapé inferior" },
    { "type": "richtext", "id": "legal_text", "label": "Informações da empresa", "default": "<p>Razão social · CNPJ 00.000.000/0001-00 · Endereço completo</p>" },
    { "type": "link_list", "id": "legal_menu", "label": "Menu legal (privacidade, termos)" },
    { "type": "checkbox", "id": "show_localization", "label": "Mostrar seletor de país/moeda", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Joias finas e diamantes certificados, criados com excelência artesanal.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociais aqui também", "default": false }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contato",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Fale conosco" },
        { "type": "text", "id": "phone", "label": "Telefone", "default": "(11) 0000-0000" },
        { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar WhatsApp", "default": true, "info": "Usa o número de Configurações do tema > WhatsApp." },
        { "type": "text", "id": "email", "label": "E-mail", "default": "contato@sualoja.com.br" },
        { "type": "textarea", "id": "hours", "label": "Horário de atendimento", "default": "Seg. a sex.: 9h às 18h\nSáb.: 10h às 14h" },
        { "type": "textarea", "id": "address", "label": "Endereço", "default": "Rua Exemplo, 123 – Jardins\nSão Paulo – SP" },
        { "type": "text", "id": "button_label", "label": "Botão - texto", "default": "Agendar visita" },
        { "type": "url", "id": "button_link", "label": "Botão - link" }
      ]
    },
    {
      "type": "text",
